{
  "name": "system-design-from-scratch",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop app for learning system design from scratch.",
  "author": "Jean-Baptiste Claramonte",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jbclaramonte/system-design-from-scratch",
  "desktopName": "system-design-from-scratch.desktop",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "package": "install-electron && electron-vite build && electron-builder --mac --arm64 && node scripts/check-package.mjs",
    "package:dir": "install-electron && electron-vite build && electron-builder --mac dir --arm64 && node scripts/check-package.mjs --app-only",
    "package:linux": "install-electron && electron-vite build && electron-builder --linux --x64 && node scripts/check-package.mjs --platform linux",
    "package:linux:dir": "install-electron && electron-vite build && electron-builder --linux dir --x64 && node scripts/check-package.mjs --platform linux --app-only",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test:install": "bash scripts/test-install.sh",
    "site:screenshots": "node scripts/site-screenshots.mjs",
    "site:check": "node scripts/check-site.mjs",
    "preview": "install-electron && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "corpus:build": "node scripts/build-corpus.ts",
    "licenses:build": "node scripts/build-licenses.ts",
    "licenses:check": "node scripts/build-licenses.ts --check",
    "icon:build": "electron scripts/build-icon.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xyflow/react": "12.12.0",
    "dompurify": "3.4.16",
    "html-to-image": "1.11.13",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
